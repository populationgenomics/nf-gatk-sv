manifest {
    name = 'nf-gatk-sv'
    description = 'GATK-SV through Cromwell, planned and driven by the nf-gatk-sv CLI (NEXTFLOW_PORT_PLAN.md)'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04'
}

// the defaults. main.nf's params block declares their types
params {
    arGuid         = null  // supplied from analysis-runner, used in billing labels
    dataset        = null  // the analysis dataset: becomes workflow.dataset, and pays for the run
    config         = null  // gs:// path of the run TOML (the layer over defaults.toml, plan §5.5)
    entry          = null  // sample_evidence | evidence_qc | multi_sample

    billingProject = null  // default: read by PLAN from the metadata server of the VM it runs on
    planOnly       = false // stop after PLAN, to inspect a plan with the real service account
    register       = true  // if false, no metamist registrations (crossover runs, plan §8)

    // GatherSampleEvidence (plan §5.6): at most gse_chunk_size x gse_max_chunks workflows in flight
    gse_chunk_size = 50
    gse_max_chunks = 4

    // runs PLAN, PREPARE_WDL and the Cromwell watchers: the nf-gatk-sv package, cpg-cromwell and gcloud.
    // Pinned here once the Dockerfile is built (Phase 0)
    driver_image   = null

    // the most a Cromwell-watching task may run for: above workflow.time_limit_seconds (24h by default), so
    // cpg-cromwell's own time limit, which aborts the workflow, is always hit first
    cromwell_task_hours = 30
}

includeConfig "${projectDir}/conf/base.config"

profiles {
    // until there is profile selection in analysis-runner, google-batch is the standard route
    standard {
        process.executor = 'google-batch'
        google.location = 'australia-southeast1'
        // not spot: the driver processes watch Cromwell for hours, and a preemption's SIGTERM would make them
        // abort their workflows. Spot can't be set per process, and the other tasks are small (plan §5.5)
        google.batch.spot = false
    }
    docker {
        docker.enabled = true
    }
    // offline wiring checks: nextflow run main.nf -profile test -stub --entry sample_evidence ...
    test {
        process.executor = 'local'
        params.arGuid = 'local-test'
        params.dataset = 'test-dataset'
        params.config = 'test/nextflow/run.toml'
        params.driver_image = 'stub'
        params.register = false
        process.resourceLimits = [cpus: 2, memory: 4.GB]
        process {
            withName: 'PLAN' {
                ext.stub_plan = "${projectDir}/test/nextflow/plan.json"
            }
        }
    }
}
