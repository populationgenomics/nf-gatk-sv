// Per-process resources, containers and error handling
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    // billed to the analysis dataset; per-dataset processes override it with their own (plan §5.5)
    resourceLabels = [
        'ar-guid': params.arGuid,
        'dataset': params.dataset,
        'compute-category': 'nextflow',
    ]
    // anything without its own strategy stops the run, letting running tasks finish
    errorStrategy = 'finish'

    // the nf-gatk-sv CLI in the driver image: planning, bundling and watching Cromwell. Each task is one small,
    // standard VM. These can't run on the head with the local executor: it needs a POSIX work dir, and the work
    // dir is in GCS (plan §5.5)
    withLabel: 'driver' {
        container = params.driver_image
        cpus = 1
        memory = 4.GB
        machineType = 'e2-standard-2'
    }

    // nothing can run without a plan or the WDL
    withName: 'PLAN|PREPARE_WDL' {
        errorStrategy = 'terminate'
    }

    // one Cromwell workflow per task (modules/stage.nf STAGE). A transient error (75) is retried, and re-attaches
    // to the workflow. Anything else (a failed workflow, a spec error, the time limit) stops new tasks but lets
    // running ones finish: killing them would abort their workflows, e.g. the other cohorts' EvidenceQC
    withLabel: 'cromwell' {
        errorStrategy = { task.exitStatus == 75 && task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries = 3
        time = "${params.cromwell_task_hours}h"
    }

    // a chunk of SGs, each its own Cromwell workflow (plan §5.6). The script turns failed SGs (exit 1) and hit
    // time limits (124) into a status the run reports once every chunk has run. What's left fails the task:
    // a transient error (75) is retried, and re-attaches to the chunk's workflows; anything else is a spec or
    // config error, which every chunk would hit, so the run stops
    withName: 'GSE_CHUNK' {
        maxForks = params.gse_max_chunks
        errorStrategy = { task.exitStatus == 75 && task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries = 3
        time = "${params.cromwell_task_hours}h"
    }
}
